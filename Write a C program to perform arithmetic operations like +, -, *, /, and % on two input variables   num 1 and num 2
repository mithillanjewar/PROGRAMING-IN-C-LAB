Write a C program to perform arithmetic operations like +, -, *, /, and % on two input variables 
 num 1 and num 2



#include <stdio.h>
void main(){
	int num1, num2;
	scanf("%d",&num1);
	scanf("%d",&num2);
	printf("%d\n",num1 + num2);
	printf("%d\n",num1 - num2);
	printf("%d\n",num1 * num2);
	printf("%d\n",num1 / num2);
	printf("%d\n",num1 % num2);
}
